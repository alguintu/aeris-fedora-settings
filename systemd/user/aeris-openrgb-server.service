[Unit]
Description=OpenRGB SDK server for Aeris lighting
After=graphical-session.target
PartOf=aeris-openrgb.service
StopWhenUnneeded=yes

[Service]
ExecStartPre=/home/drei/.local/share/aeris-openrgb/check-openrgb-safety.sh
ExecStartPre=/home/drei/.local/share/aeris-openrgb/configure-openrgb-detectors.py --require-aeris
ExecStartPre=/usr/bin/udevadm settle --timeout=15
ExecStart=/usr/bin/openrgb --noautoconnect --server --server-host 127.0.0.1 --server-port 6742
ExecStartPost=/usr/bin/sleep 10
Restart=no

[Install]
WantedBy=default.target
