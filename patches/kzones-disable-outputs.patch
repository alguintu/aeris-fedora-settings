@@ -108,0 +111,13 @@
+    function outputIsDisabled(output) {
+        if (!output || !output.name) return false;
+        return config.disabledOutputs.includes(output.name.toString());
+    }
+
+    function activeOutputIsDisabled() {
+        return outputIsDisabled(Workspace.activeScreen);
+    }
+
+    function clientOutputIsDisabled(client) {
+        return client && outputIsDisabled(client.output);
+    }
